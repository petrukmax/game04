extends Node
## Global signal hub. Gameplay never reaches into UI nodes directly.

signal credits_changed(credits: int)
signal base_health_changed(current: int, maximum: int)
signal wave_started(index: int, total: int, preview: String)
signal wave_completed(index: int, bonus: int)
signal all_waves_completed()
signal enemy_killed(enemy_name: String, bounty: int)
signal enemy_leaked(enemy_name: String, damage: int)
signal tower_placed(tower: Node)
signal tower_selected(tower: Node)
signal tower_upgraded(tower: Node)
signal tower_sold(tower: Node)
signal build_mode_changed(tower_id: String)
signal selection_cleared()
signal speed_changed(speed: int)
signal notification(text: String, color: Color)
signal game_paused(paused: bool)
signal level_completed(stars: int)
signal level_failed()
signal ability_used(ability_id: String)
signal ability_state_changed()
signal damage_number(world_position: Vector2, amount: float, kind: String)
signal tower_disabled(tower: Node, duration: float)
signal boss_phase(text: String)
